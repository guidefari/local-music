{
  "$schema": "https://raw.githubusercontent.com/nicksrandall/oxfmt/refs/heads/main/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "experimentalSortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
    "newlinesBetween": true
  },
  "sortTailwindcss": { "stylesheet": "./apps/electron/src/styles.css" },
  "ignorePatterns": [
    "**/node_modules/**", "**/dist/**", "**/build/**", "**/.next/**",
    "**/.turbo/**", "**/coverage/**", "**/*.gen.*", "**/*.generated.*",
    "**/routeTree.gen.ts", "**/package.json", "**/tsconfig.json",
    "tools/oxlint/anti-slop/**"
  ]
}
