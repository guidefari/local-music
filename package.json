{
  "name": "local-music",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:desktop": "bun run --filter '@local-music/desktop' dev",
    "dev:electron": "bun run dev:desktop",
    "build": "bun run --filter '@local-music/*' build",
    "check": "bun run --filter '@local-music/*' check",
    "test": "bun run --filter '@local-music/*' test",
    "check:desktop": "bun run --filter '@local-music/desktop' check",
    "test:desktop": "bun run --filter '@local-music/desktop' test",
    "check:electron": "bun run check:desktop",
    "test:electron": "bun run test:desktop",
    "lint": "oxlint apps/electron/src apps/electron/vite.config.mjs apps/electron/drizzle.config.ts",
    "lint:fix": "oxlint --fix apps/electron/src apps/electron/vite.config.mjs apps/electron/drizzle.config.ts",
    "format": "oxfmt apps/electron/src apps/electron/vite.config.mjs apps/electron/drizzle.config.ts",
    "format:check": "oxfmt --check apps/electron/src apps/electron/vite.config.mjs apps/electron/drizzle.config.ts",
    "check:effect": "effect-language-service diagnostics --project apps/electron/tsconfig.json",
    "verify": "bun run lint && bun run format:check && bun run check && bun run check:effect && bun run test && bun run build"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.3",
    "@oxlint/plugins": "1.86.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tailwindcss": "1.14.0"
  }
}
